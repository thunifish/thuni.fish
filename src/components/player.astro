---
import { Icon } from "astro-icon/components";
---

<div class="w-[min(100%,420px)] desktop:w-[min(100%,360px)]">
  <section
    class="group/player grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-[7px] rounded-[1em] border border-line bg-soft p-3.5 text-left"
    aria-label="Música a tocar"
    data-player
    data-playing="false"
  >
    <p class="col-span-full m-0 flex items-center gap-[7px] text-[13px] tracking-[0.01em] text-muted">
      <span class="inline-flex h-3 w-[13px] flex-none items-end gap-0.5" aria-hidden="true">
        <span
          class="h-full w-[3px] origin-bottom scale-y-[0.3] rounded-full bg-current group-data-[playing=true]/player:animate-equalizer"
        ></span>
        <span
          class="h-[70%] w-[3px] origin-bottom scale-y-[0.3] rounded-full bg-current [animation-delay:150ms] group-data-[playing=true]/player:animate-equalizer"
        ></span>
        <span
          class="h-[85%] w-[3px] origin-bottom scale-y-[0.3] rounded-full bg-current [animation-delay:300ms] group-data-[playing=true]/player:animate-equalizer"
        ></span>
      </span>
      <span data-player-status role="status">sem música por enquanto</span>
    </p>
    <button
      class="group/track grid min-w-0 gap-px p-0 text-left focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink disabled:cursor-default"
      type="button"
      data-track-info
      disabled
      aria-haspopup="dialog"
    >
      <span
        class="overflow-hidden text-[15px] font-bold text-ellipsis whitespace-nowrap group-hover/track:underline group-hover/track:underline-offset-[3px]"
        data-track-title>sem música por enquanto</span
      >
      <span
        class="overflow-hidden text-xs text-ellipsis whitespace-nowrap text-muted"
        data-track-artist
        >adiciona sons em sounds/sounds.json pra começa a ouvi :3</span
      >
    </button>
    <div class="flex items-center gap-2">
      <button
        class="group/play grid size-9 place-items-center rounded-full border border-line bg-ink text-paper transition-[background-color,color,transform] duration-150 enabled:hover:scale-[1.06] enabled:hover:bg-transparent enabled:hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ink enabled:active:scale-[0.92] disabled:cursor-default disabled:opacity-35"
        type="button"
        data-pause
        disabled
        data-playing="false"
        aria-label="Continuar música"
        title="Continuar música"
      >
        <Icon
          name="andrsrxn:pause"
          class="block size-[15px] group-data-[playing=false]/play:hidden"
        />
        <Icon
          name="andrsrxn:play"
          class="block size-[15px] group-data-[playing=true]/play:hidden"
        />
      </button>
      <button
        class="grid size-9 place-items-center rounded-full border border-line bg-transparent text-ink transition-[background-color,color,transform] duration-150 enabled:hover:scale-[1.06] enabled:hover:bg-ink enabled:hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-ink enabled:active:scale-[0.92] disabled:cursor-default disabled:opacity-35"
        type="button"
        data-next
        disabled
        aria-label="Próxima música"
        title="Próxima música"
      >
        <Icon name="andrsrxn:skip-forward" class="block size-[15px]" />
      </button>
    </div>
    <div class="col-span-full grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2">
      <span class="min-w-[30px] text-[11px] leading-none text-muted tabular-nums first:text-right" data-time-current
        >0:00</span
      >
      <input
        class="player-range"
        type="range"
        min="0"
        max="100"
        step="0.1"
        value="0"
        data-progress
        disabled
        aria-label="Progresso da música"
        aria-valuetext="0:00 de 0:00"
      />
      <span class="min-w-[30px] text-[11px] leading-none text-muted tabular-nums first:text-right" data-time-duration
        >0:00</span
      >
    </div>
    <audio class="hidden" data-audio preload="auto"></audio>
  </section>
</div>
