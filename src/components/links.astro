---
import { Icon } from "astro-icon/components";
import { LINKS } from "@/data/links";
---

<section
  class="m-0 w-[min(100%,420px)] desktop:w-full"
  aria-labelledby="links-title"
>
  <h2
    id="links-title"
    class="mb-2 text-center font-display text-[22px] tracking-[-0.06em]"
  >
    meus links!
  </h2>
  <nav class="flex flex-wrap justify-center gap-x-1 gap-y-0.5" aria-label="redes sociais">
    {
      LINKS.map((link) => (
        <a
          class="grid size-11 place-items-center text-ink no-underline transition-[transform,color] duration-[160ms] hover:-translate-y-[3px] hover:scale-[1.06] hover:text-muted hover:outline-none focus-visible:-translate-y-[3px] focus-visible:scale-[1.06] focus-visible:text-muted focus-visible:outline-none active:-translate-y-px active:scale-[0.98]"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.label}
        >
          <Icon name={link.icon} class="block size-[1.55rem] text-current" aria-hidden="true" />
        </a>
      ))
    }
  </nav>
</section>
