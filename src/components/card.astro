---
import { Image } from "astro:assets";
import type { InfoCardData } from "@/data/info";

type Props = InfoCardData;

const { title, face, lead, text, thumbs = [] } = Astro.props;
---

<article class="group/card min-w-0 transition-transform duration-200 hover:-translate-y-0.5">
  <h2 class="mb-2 font-display text-2xl leading-none font-bold tracking-[-0.07em] max-[400px]:text-[21px]">
    {title}
    {face && (
      <span class="inline-block font-sans text-[0.62em] font-medium tracking-normal transition-transform duration-[250ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover/card:rotate-[-8deg] group-hover/card:scale-110">
        {face}
      </span>
    )}
  </h2>
  <p class="mb-0 text-[15px] leading-[1.42] max-[400px]:text-sm">
    {lead ? (
      <>
        <strong class="font-bold text-muted">{lead}</strong> {text}
      </>
    ) : (
      text
    )}
  </p>
  {thumbs.length > 0 && (
    <div class="mt-3.5 flex gap-2.5">
      {thumbs.map((thumb) => (
        <Image
          class="block size-[52px] flex-none rounded-xl border-2 border-line bg-soft object-cover transition-transform duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] first:-rotate-3 last:rotate-3 hover:-translate-y-[3px] hover:rotate-0 hover:scale-[1.04] active:-translate-y-px active:rotate-0 active:scale-[0.98] max-[400px]:size-[46px]"
          src={thumb.src}
          alt={thumb.alt ?? ""}
          width={104}
          height={104}
          loading="lazy"
        />
      ))}
    </div>
  )}
</article>
