---
import { PLAYER } from "@/config";

interface Props {
  title?: string;
  artist?: string;
  author?: string;
  copyright?: string;
}

const {
  title = "—",
  artist = PLAYER.fallbackArtist,
  author = "não informado",
  copyright = "© todos os direitos pertencem ao autor.",
} = Astro.props;
---

<dialog
  class="dialog-pop relative m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-[390px] rounded-[18px] border-[1.5px] border-line bg-paper px-[22px] pt-[22px] pb-6 text-left text-ink [font:inherit]"
  data-track-dialog
  aria-labelledby="credit-title"
>
  <div class="flex items-start justify-between gap-3">
    <p class="m-0 text-[13px] text-muted">créditos da música</p>
    <button
      class="-mt-2 -mr-2 grid size-10 place-items-center rounded-full font-[Arial,sans-serif] text-[28px] leading-none transition-[background-color,color,transform] duration-150 hover:rotate-90 hover:bg-ink hover:text-paper hover:outline-none focus-visible:rotate-90 focus-visible:bg-ink focus-visible:text-paper focus-visible:outline-none active:rotate-90 active:scale-90"
      type="button"
      aria-label="Fechar créditos"
      data-close-dialog
    >
      ×
    </button>
  </div>
  <h2
    id="credit-title"
    class="mt-2 mb-0 font-display text-[23px] tracking-[-0.05em]"
    data-credit-title
  >
    {title}
  </h2>
  <p class="mt-1 mb-[18px] text-muted" data-credit-artist>
    {artist}
  </p>
  <dl class="m-0 grid gap-3">
    <div class="grid gap-0.5">
      <dt class="text-[13px] text-muted">autor / artista</dt>
      <dd class="m-0 text-[17px]" data-credit-author>
        {author}
      </dd>
    </div>
    <div class="grid gap-0.5">
      <dt class="text-[13px] text-muted">uso</dt>
      <dd class="m-0 text-[17px]" data-credit-copyright>
        {copyright}
      </dd>
    </div>
  </dl>
  <div class="mt-[18px]" data-credit-source-slot hidden></div>
</dialog>
