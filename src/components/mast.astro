---
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.png";
import Links from "@/components/links.astro";
---

<div class="flex w-full flex-col items-center gap-3 desktop:gap-4">
  <Image
    src={avatar}
    alt="avatar do thom"
    class="block size-[20em] scale-[0.86] rounded-full border-2 border-line object-cover object-center"
    width={276}
    height={276}
    densities={[1, 2]}
    loading="eager"
    fetchpriority="high"
    data-avatar
  />
  <div class="hidden w-full desktop:block">
    <Links id="links-title-desktop" />
  </div>
</div>
