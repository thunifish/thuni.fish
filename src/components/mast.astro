---
import { Image } from "astro:assets";
import avatar from "@/assets/avatar.jpg";
import Links from "@/components/links.astro";
---

<div class="mast">
  <Image
    src={avatar}
    alt="avatar do thom"
    class="avatar"
    width={460}
    height={460}
    loading="eager"
    data-avatar
  />
  <Links />
</div>
