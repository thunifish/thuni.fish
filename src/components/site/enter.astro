---
import { Image } from "astro:assets";
import cute from "@/assets/cute.png";
import { t } from "@/i18n";
---

<div
  class="fixed inset-0 z-10 grid place-items-center bg-paper/[0.94] backdrop-blur-[8px] transition-opacity duration-[400ms] ease-[ease] [&.is-hidden]:pointer-events-none [&.is-hidden]:opacity-0"
  data-enter-screen
  role="dialog"
  aria-modal="true"
  aria-labelledby="enter-title"
>
  <button
    class="grid justify-items-center gap-2.5 p-5 transition-transform duration-[180ms] hover:-translate-y-1 focus-visible:-translate-y-1 focus-visible:outline-none active:-translate-y-px active:scale-[0.98]"
    type="button"
    data-enter
  >
    <Image
      src={cute}
      alt={t("enter.imageAlt")}
      data-i18n-alt="enter.imageAlt"
      class="size-40 object-contain desktop:size-48"
      width={385}
      height={385}
      quality={95}
      loading="eager"
      fetchpriority="high"
    />
    <small
      id="enter-title"
      class="font-display tracking-[-0.04em]"
      data-i18n="enter.click"
    >
      {t("enter.click")}
    </small>
  </button>
</div>
