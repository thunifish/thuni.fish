---
import Layout from "@/layouts/layout.astro";
import Enter from "@/components/enter.astro";
import Mast from "@/components/mast.astro";
import Intro from "@/components/intro.astro";
import Player from "@/components/player.astro";
import Info from "@/components/info.astro";
import Fish from "@/components/fish.astro";
import Footer from "@/components/footer.astro";
import Dialog from "@/components/dialog.astro";
---

<Layout>
  <Enter />
  <main
    class="mx-auto w-[min(100%,860px)] px-0 pt-1 pb-2 transition-[filter,opacity] duration-[450ms] ease-[ease] aria-hidden:select-none aria-hidden:opacity-55 aria-hidden:blur-[10px]"
    data-main
    aria-hidden="true"
    inert
  >
    <section
      class="flex flex-col items-center gap-[22px] desktop:grid desktop:grid-cols-[minmax(240px,292px)_minmax(0,1fr)] desktop:items-start desktop:gap-x-16 desktop:gap-y-0"
      aria-label="perfil do thom"
    >
      <Mast />
      <div class="flex w-full flex-col items-center gap-3 desktop:items-stretch desktop:gap-7 desktop:pt-2.5">
        <Intro />
        <Player />
      </div>
    </section>
    <Info />
    <Fish />
    <Footer />
  </main>
  <Dialog />
  <script src="../scripts/site.ts"></script>
</Layout>
