---
import Layout from "@/layouts/layout.astro";
import Enter from "@/components/enter.astro";
import Mast from "@/components/mast.astro";
import Intro from "@/components/intro.astro";
import Player from "@/components/player.astro";
import Info from "@/components/info.astro";
import Fish from "@/components/fish.astro";
import Footer from "@/components/footer.astro";
import Dialog from "@/components/dialog.astro";
---

<Layout>
  <Enter />
  <main class="container" data-main aria-hidden="true" inert>
    <section class="hero" aria-label="perfil do thom">
      <Mast />
      <div class="profile-stack">
        <Intro />
        <Player />
      </div>
    </section>
    <Info />
    <Fish />
    <Footer />
  </main>
  <Dialog />
  <script src="../scripts/site.ts"></script>
</Layout>
